{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "references": [{ "path": "tsconfig.build.json" }],
    "include": ["**/vitest.*.ts", "./test/**/*.ts"],
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "erasableSyntaxOnly": false,
        "resolveJsonModule": true,
        "types": ["node"],
        "paths": {
            "skyportal-js": ["./src/index.ts"],
            "skyportal-js/*": ["./src/*.ts"]
        }
    }
}

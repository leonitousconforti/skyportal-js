{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["**/dist", "**/build", "**/docs", "**/.tsbuildinfo", ".agents/**/*", "**/index.ts"],
    "sortPackageJson": true,
    "trailingComma": "es5",
    "sortImports": {
        "newlinesBetween": true,
        "sortSideEffects": true,
        "internalPattern": ["./", "~/", "@/"],
        "groups": [
            "side_effect",
            "valibot-types",
            "valibot",
            "builtin",
            ["type-external", "type-parent", "type-sibling", "type-index"],
            "external",
            ["internal", "subpath"],
            ["value-parent", "value-sibling", "value-index"],
            "unknown"
        ],
        "customGroups": [
            {
                "selector": "type",
                "groupName": "valibot-types",
                "elementNamePattern": ["valibot", "valibot/**"]
            },
            {
                "groupName": "valibot",
                "elementNamePattern": ["valibot", "valibot/**"]
            }
        ]
    }
}
